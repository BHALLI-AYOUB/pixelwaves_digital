# PixelWaves Digital — environment settings
#
# Local:      copy this file to .env and fill it in (.env is git-ignored).
# Production: add the same variables in Vercel → Project → Settings → Environment
#             Variables, then redeploy.
#
# Check your setup before deploying:   npm run test:contact

# ─── Contact form delivery ──────────────────────────────────────────────────────
# Configure AT LEAST ONE channel. With none configured, the production form tells
# visitors their brief could not be sent and offers WhatsApp instead — it never
# pretends to succeed. Several channels can run together (e.g. Telegram + email).

# Where brief notifications are sent (comma-separate several addresses).
CONTACT_TO=pixelwaves_digital@outlook.com

# Option A — Telegram (recommended: free, instant on your phone, 2 minutes to set up)
#   1. In Telegram, open @BotFather → /newbot → copy the token.
#   2. Send any message to your new bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B — Resend (email over HTTPS, free tier: https://resend.com)
#   Without a verified domain, Resend only delivers to your own account email and
#   the visitor confirmation email is skipped. Verify your domain to enable both.
RESEND_API_KEY=
# RESEND_FROM=PixelWaves Digital <hello@yourdomain.ma>

# Option C — SMTP (any mailbox; Outlook/Hotmail needs an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=PixelWaves Digital <hello@yourdomain.ma>

# Option D — Webhook (Slack, Discord, Make, Zapier, n8n…); receives JSON
CONTACT_WEBHOOK_URL=

# Visitor confirmation email ("we received your brief"), sent through Resend (with a
# verified RESEND_FROM) or SMTP. Set to false to disable.
CONTACT_AUTOREPLY=true

# ─── Site ───────────────────────────────────────────────────────────────────────
# Public URL, used for canonical, hreflang, Open Graph and sitemap links.
# Set it when you run `npm run build` (the built HTML is what gets deployed).
SITE_URL=
