{
  "version": 2,
  "builds": [
    { "src": "api/contact.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "/public/(fonts|work|team|brand)/(.*)", "headers": { "cache-control": "public, max-age=604800, stale-while-revalidate=2592000" }, "continue": true },
    { "src": "/fr", "status": 308, "headers": { "Location": "/fr/" } },
    { "src": "/(work|fr/projets)/([^/]+)", "status": 308, "headers": { "Location": "/$1/$2/" } },
    { "src": "/fr/", "dest": "/fr/index.html" },
    { "src": "/(work|fr/projets)/([^/]+)/", "dest": "/$1/$2/index.html" },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
